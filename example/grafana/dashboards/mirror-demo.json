{
 "uid": "mirror-demo",
 "title": "Demo: Python v1 vs Python v2",
 "tags": [
  "mirror",
  "shadow"
 ],
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "ds",
    "label": "Datasource",
    "type": "datasource",
    "query": "prometheus"
   },
   {
    "name": "service",
    "label": "Service",
    "type": "custom",
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "query": "demo",
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "route",
    "label": "Endpoint",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${ds}"
    },
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "query": {
     "query": "label_values(shadow_requests_total{service=~\"$service\"}, route)",
     "refId": "route"
    },
    "refresh": 2,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Overview ($service)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Parity",
   "description": "Share of compared requests where Python v1 and Python v2 answered the same. Cutover target: >= 99.5 %",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "100 * (sum(increase(shadow_compare_total{service=~\"$service\", route=~\"$route\", result=\"match\"}[$__range])) or vector(0)) / clamp_min(sum(increase(shadow_compare_total{service=~\"$service\", route=~\"$route\", result!=\"skipped\"}[$__range])), 1)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 98
       },
       {
        "color": "green",
        "value": 99.5
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Compared",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(increase(shadow_compare_total{service=~\"$service\", route=~\"$route\", result!=\"skipped\"}[$__range]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Differences",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(increase(shadow_compare_total{service=~\"$service\", route=~\"$route\", result=~\"body_diff|status_diff\"}[$__range])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Python v2 error / timeout",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(increase(shadow_compare_total{service=~\"$service\", route=~\"$route\", result=~\"shadow_error|shadow_timeout\"}[$__range])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "p95 Python v1",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(shadow_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", backend=\"primary\"}[$__range])))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 7,
   "type": "stat",
   "title": "p95 Python v2",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(shadow_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", backend=\"shadow\"}[$__range])))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none"
   }
  },
  {
   "id": 8,
   "type": "row",
   "title": "Latency: Python v1 vs Python v2",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Response time p50 / p95 / p99",
   "description": "Same request, measured by the proxy for both backends.",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 16,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(shadow_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", backend=\"primary\"}[$__rate_interval])))",
     "legendFormat": "Python v1 p50",
     "refId": "p50primary"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(shadow_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", backend=\"shadow\"}[$__rate_interval])))",
     "legendFormat": "Python v2 p50",
     "refId": "p50shadow"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(shadow_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", backend=\"primary\"}[$__rate_interval])))",
     "legendFormat": "Python v1 p95",
     "refId": "p95primary"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(shadow_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", backend=\"shadow\"}[$__rate_interval])))",
     "legendFormat": "Python v2 p95",
     "refId": "p95shadow"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(shadow_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", backend=\"primary\"}[$__rate_interval])))",
     "legendFormat": "Python v1 p99",
     "refId": "p99primary"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(shadow_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", backend=\"shadow\"}[$__rate_interval])))",
     "legendFormat": "Python v2 p99",
     "refId": "p99shadow"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^Python\\ v1( .*)?$|.* · Python\\ v1$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3274D9"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^Python\\ v2( .*)?$|.* · Python\\ v2$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#00ADD8"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Requests / second",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 16,
    "y": 6,
    "w": 8,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(rate(shadow_requests_total{service=~\"$service\", route=~\"$route\", backend=\"primary\"}[$__rate_interval]))",
     "legendFormat": "Python v1",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum(rate(shadow_requests_total{service=~\"$service\", route=~\"$route\", backend=\"shadow\"}[$__rate_interval]))",
     "legendFormat": "Python v2",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^Python\\ v1( .*)?$|.* · Python\\ v1$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3274D9"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^Python\\ v2( .*)?$|.* · Python\\ v2$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#00ADD8"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 11,
   "type": "table",
   "title": "Per endpoint: latency and parity",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (route) (increase(shadow_requests_total{service=~\"$service\", route=~\"$route\", backend=\"primary\"}[$__range]))",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(shadow_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", backend=\"primary\"}[$__range])))",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(shadow_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", backend=\"shadow\"}[$__range])))",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "100 * (sum by (route) (increase(shadow_compare_total{service=~\"$service\", route=~\"$route\", result=\"match\"}[$__range])) or 0 * sum by (route) (increase(shadow_compare_total{service=~\"$service\", route=~\"$route\", result!=\"skipped\"}[$__range]))) / clamp_min(sum by (route) (increase(shadow_compare_total{service=~\"$service\", route=~\"$route\", result!=\"skipped\"}[$__range])), 1)",
     "legendFormat": "",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "route": "Endpoint",
       "Value #A": "Requests",
       "Value #B": "p95 Python v1",
       "Value #C": "p95 Python v2",
       "Value #D": "Parity %"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "p95.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Requests"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Parity %"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "decimals",
        "value": 2
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "orange",
           "value": 98
          },
          {
           "color": "green",
           "value": 99.5
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "sortBy": [
     {
      "displayName": "Parity %",
      "desc": false
     }
    ]
   }
  },
  {
   "id": 12,
   "type": "row",
   "title": "Comparison",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Result over time",
   "description": "match | body_diff | status_diff | shadow_error | shadow_timeout | skipped",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (result) (rate(shadow_compare_total{service=~\"$service\", route=~\"$route\"}[$__rate_interval]))",
     "legendFormat": "{{result}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^Python\\ v1( .*)?$|.* · Python\\ v1$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3274D9"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^Python\\ v2( .*)?$|.* · Python\\ v2$"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#00ADD8"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 14,
   "type": "table",
   "title": "Status code differences (Python v1 → Python v2)",
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "gridPos": {
    "x": 12,
    "y": 26,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${ds}"
     },
     "expr": "sum by (route, primary_code, shadow_code) (increase(shadow_status_diff_total{service=~\"$service\", route=~\"$route\"}[$__range])) > 0",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "route": "Endpoint",
       "primary_code": "Python v1",
       "shadow_code": "Python v2",
       "Value": "Count"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    },
    "overrides": []
   }
  },
  {
   "id": 15,
   "type": "table",
   "title": "Differences (latest first)",
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "shadow-infinity"
   },
   "description": "Requests where the answers differed. Secrets are masked. Filter by column headers; click a body cell to see it whole.",
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 24,
    "h": 14
   },
   "targets": [
    {
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "shadow-infinity"
     },
     "refId": "A",
     "type": "json",
     "source": "url",
     "format": "table",
     "parser": "backend",
     "url": "http://proxy:9187/diffs.json",
     "url_options": {
      "method": "GET",
      "data": ""
     },
     "root_selector": "",
     "columns": [
      {
       "selector": "time",
       "text": "Time",
       "type": "timestamp"
      },
      {
       "selector": "service",
       "text": "Service",
       "type": "string"
      },
      {
       "selector": "result",
       "text": "Result",
       "type": "string"
      },
      {
       "selector": "method",
       "text": "Method",
       "type": "string"
      },
      {
       "selector": "route",
       "text": "Endpoint",
       "type": "string"
      },
      {
       "selector": "primary_status",
       "text": "Python v1 status",
       "type": "number"
      },
      {
       "selector": "shadow_status",
       "text": "Python v2 status",
       "type": "number"
      },
      {
       "selector": "primary_ms",
       "text": "Python v1 ms",
       "type": "number"
      },
      {
       "selector": "shadow_ms",
       "text": "Python v2 ms",
       "type": "number"
      },
      {
       "selector": "paths",
       "text": "Differing paths",
       "type": "string"
      },
      {
       "selector": "shadow_error",
       "text": "Python v2 error",
       "type": "string"
      },
      {
       "selector": "primary_body",
       "text": "Python v1 body",
       "type": "string"
      },
      {
       "selector": "shadow_body",
       "text": "Python v2 body",
       "type": "string"
      },
      {
       "selector": "path",
       "text": "Full path",
       "type": "string"
      }
     ]
    }
   ],
   "transformations": [
    {
     "id": "merge"
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Time",
        "desc": true
       }
      ]
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true,
      "inspect": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Result"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "status_diff": {
            "color": "red",
            "index": 0
           },
           "shadow_error": {
            "color": "red",
            "index": 1
           },
           "shadow_timeout": {
            "color": "red",
            "index": 2
           },
           "body_diff": {
            "color": "orange",
            "index": 3
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".* ms"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".* body"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 320
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Full path"
      },
      "properties": [
       {
        "id": "custom.hidden",
        "value": true
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": true,
     "reducer": [
      "count"
     ],
     "fields": [
      "Endpoint"
     ]
    }
   }
  }
 ]
}